# Project config for the conductr repo — generated by `conductr setup wizard`.
# `conductr begin` reads `tag` and `repo`; other fields are reserved for future tooling.

project_tag = "conductr"
repo        = "Luan-vP/conductr"

[band]
human_assignee = "Luan-vP"

[band.defaults]
# Default voicing per role for tmux-pane execution.
# Web-runner beats use whatever GH Actions Claude Code is configured with — not set here.
architect    = "opus"
implementer  = "sonnet"
reviewer     = "sonnet"
tester       = "haiku"
security     = "haiku"
doc-writer   = "sonnet"
idle-sweeper = "opus"

[orchestrate]
max_parallel_beats   = 3        # agent<n> slot cap
max_parallel_qa      = 2        # qa<n> slot cap
tmux_complexity_min  = "L"      # escalate to tmux at this complexity or above

[cadence]
# Per-task cron expressions. The host crontab is the source of truth for now;
# a future `conductr setup cron` pass will sync the active crontab to match
# this object. Add a key per task you want scheduled.
#
# orchestrate: every 30 minutes.
orchestrate = "*/30 * * * *"

[local]
# Default local AI agent provider for `conductr run-task`.
# Precedence: --provider flag > CONDUCTR_LOCAL_PROVIDER env > this section > auto-detect.
# Valid values: "ollama", "llamacpp", "pi"
provider = "ollama"
# model = "qwen3:27b"   # ollama only; omit to use the default (qwen3:27b)

[tempo]
# Completed orchestrate bars are appended here after each successful pass.
# Format: { ts = "ISO-8601", merged = N, triggered = N }
entries = []
