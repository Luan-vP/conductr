# Project config for the conductr repo — generated by `conductr setup wizard`.
# Run `conductr begin` to write cadence defaults and sync cron entries.

project_tag = "conductr"
repo        = "Luan-vP/conductr"

[band]
human_assignee = "Luan-vP"

[band.defaults]
# Default voicing per role for tmux-pane execution.
# Web-runner beats use whatever GH Actions Claude Code is configured with — not set here.
architect    = "opus"
implementer  = "sonnet"
reviewer     = "sonnet"
tester       = "haiku"
security     = "haiku"
doc-writer   = "sonnet"
idle-sweeper = "opus"

[architecture]
# Declares the architectural style for `conductr idle` to scan against.
# Supported: "hexagonal"
style     = "hexagonal"
reference = ".claude/base.md"

[cadence]
# Per-task cron expressions. The host crontab is the source of truth for now;
# a future `conductr setup cron` pass will sync the active crontab to match
# this object. Add a key per task you want scheduled.
#
# orchestrate: every 30 minutes.
orchestrate = "*/30 * * * *"
# idle: once an hour, offset from orchestrate to avoid contention.
idle        = "17 * * * *"

[local]
# Default local AI agent provider for `conductr run-task`.
# Precedence: --provider flag > CONDUCTR_LOCAL_PROVIDER env > this section > auto-detect.
# Valid values: "ollama", "llamacpp", "pi"
provider = "ollama"
# model = "qwen3:27b"   # ollama only; omit to use the default (qwen3:27b)

[idle]
# State written by `conductr idle` after each pass.
# last_module: the use-case crate scanned most recently (empty = not yet run).
# last_run:    ISO-8601 timestamp of the most recent pass.
last_module = ""
last_run    = ""

[tempo]
# Per-PR records written by architect and orchestrate passes.
# [[tempo.prs]] — one row per closed PR; appended by `orchestrate` on PR close.
# Schema (see docs/cadence.md §2):
#   number     = <int>          PR number
#   phrase     = "<string>"     optional; absent = ad-hoc
#   chord      = "<string>"     optional
#   complexity = "XS|S|M|L"     defaults to "M"
#   opened     = "<ISO-8601>"
#   closed     = "<ISO-8601>"
#   merged     = true|false

# [[ci.runs]] — one row per CI run; appended by `orchestrate` on CI completion.
# Schema (see docs/cadence.md §2):
#   pr      = <int>
#   minutes = <float>
#   ts      = "<ISO-8601>"
